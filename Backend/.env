# Django Configuration
DJANGO_SECRET_KEY=django-insecure-rms-dev-key-change-in-production
ENVIRONMENT=development

# MySQL Database (only used when ENVIRONMENT=production)
DB_NAME=rms_database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# CORS (both dev and production origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://rental-management-services.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:80,http://localhost:5173,https://rental-management-services.vercel.app

# Firebase (optional)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=

# App
APP_PORT=8000
LOG_LEVEL=INFO
